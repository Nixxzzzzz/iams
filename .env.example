# ==============================================================================
# Asset Management Portal - Environment Configuration Template
# Source of Truth: docs/GOOGLE_SHEETS_INTEGRATION.md, docs/ARCHITECTURE.md
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO REPOSITORY
# ==============================================================================

NODE_ENV=development
APP_URL=http://localhost:3000

# 32+ character secret for signing HttpOnly session cookies
SESSION_SECRET=dev-session-secret-must-be-replaced-in-prod-with-32-chars

# Allowed email domains for authentication (comma-separated, no wildcards allowed)
# In production, set to your corporate domain (e.g., organization.com)
ALLOWED_EMAIL_DOMAINS=NOT_CONFIGURED

# Optional specific allowed email addresses (comma-separated)
ALLOWED_EMAILS=

# ==============================================================================
# Google Cloud Service Account & Sheets Persistence (Phase 1)
# ==============================================================================
# The Google Spreadsheet ID from your private workbook URL
GOOGLE_SPREADSHEET_ID=

# The Service Account email provisioned in Google Cloud IAM
# e.g., asset-portal-daemon@organization-assets.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The RSA Private Key for the Service Account (PEM / PKCS8 format)
# Note: Escape newlines if pasting into a single-line environment variable (\n)
GOOGLE_PRIVATE_KEY=
